# ---------------------------------------------------------------------------
# UniFi Protect
# ---------------------------------------------------------------------------
# Hostname or IP of the UniFi OS console (UDM / UNVR / Cloud Key).
UNIFI_HOST=192.168.1.1
# Create under UniFi OS -> Settings -> Admins & Users -> your user -> API Keys.
UNIFI_API_KEY=changeme
#UNIFI_PORT=443
# UniFi ships a self-signed certificate; set true only if you installed a real one.
#UNIFI_VERIFY_SSL=false
# Seconds between full camera polls.
#UNIFI_POLL_INTERVAL=5
#UNIFI_REQUEST_TIMEOUT=10
# Subscribe to the live event websocket in addition to polling.
#UNIFI_USE_WEBSOCKET=true

# ---------------------------------------------------------------------------
# MQTT
# ---------------------------------------------------------------------------
MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_CLIENT_ID=unifi-occupancy
#MQTT_TOPIC_PREFIX=unifi-occupancy
#MQTT_TLS=false
#MQTT_KEEPALIVE=60
#MQTT_RETAIN=true
#MQTT_QOS=0

# ---------------------------------------------------------------------------
# Home Assistant autodiscovery
# ---------------------------------------------------------------------------
#HA_DISCOVERY_ENABLED=true
#HA_DISCOVERY_PREFIX=homeassistant
#HA_NODE_ID=unifi_occupancy

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How long a detection stays ON after the last event reporting it.
#DETECTION_HOLD_SECONDS=30
#LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Camera health check (optional, off by default, and the one feature that
# reads pictures)
# ---------------------------------------------------------------------------
# Once an hour, take one snapshot per camera and ask a vision model whether the
# camera still sees anything useful -- is it blocked, smeared, fogged, out of
# focus, pointed at a wall? The verdict is published on
# unifi-occupancy/<camera>/health as {"health": "good"} or
# {"health": "bad", "explanation": "..."}.
#
# Leaving this unset keeps the service as it was: no snapshot endpoint is ever
# called, and nothing leaves the process but booleans.
#CAMERA_HEALTH_ENABLED=false
# Any OpenAI-compatible /chat/completions endpoint: OpenAI, OpenRouter, or a
# local Ollama / llama.cpp / vLLM / LM Studio server.
#CAMERA_HEALTH_API_BASE_URL=https://api.openai.com/v1
# Optional -- local servers usually want no key at all.
#CAMERA_HEALTH_API_KEY=
# Must be a model that can see images.
#CAMERA_HEALTH_MODEL=gpt-4o-mini
#CAMERA_HEALTH_INTERVAL_MINUTES=60
# Seconds between one camera's check and the next, so a sweep is a trickle.
#CAMERA_HEALTH_STAGGER_SECONDS=5
#CAMERA_HEALTH_REQUEST_TIMEOUT=60
# Full-resolution snapshots: a better look, a bigger upload, a larger bill.
#CAMERA_HEALTH_HIGH_QUALITY_SNAPSHOT=false
#CAMERA_HEALTH_MAX_EXPLANATION_CHARS=200
# The question itself. The built-in prompt is the one below; override it to
# tighten it up for your cameras, or to answer in another language. Whatever it
# says, it should ask for {"health": "good"} or {"health": "bad",
# "explanation": "..."} -- a bare "good"/"bad" is understood too.
#CAMERA_HEALTH_PROMPT=You are inspecting a single still frame from a fixed security camera to decide whether the camera itself is still producing a usable picture. You are not judging whether anything interesting is happening in the scene. Answer bad if the view is obstructed or blocked (a wall, a vehicle, foliage, a cover, tape, a hand), out of focus, blurred or smeared, dirty, fogged by condensation or spiderweb, washed out by glare or an infrared reflection off a nearby surface, almost entirely black or entirely white, visibly corrupted (banding, tearing, a green or magenta cast), or aimed somewhere useless such as straight at the sky, the ground or a ceiling. Answer good if the frame shows a usable view of whatever it is pointed at, even if it is dull, empty, grainy, rainy, snowy or lit only by infrared at night. Night-time darkness on its own is not a fault; an image with no discernible structure at all is. Reply with JSON and nothing else: {"health": "good"} or {"health": "bad", "explanation": "<at most 15 words>"}.

# ---------------------------------------------------------------------------
# Daily occupancy sheets
# ---------------------------------------------------------------------------
# Camera groups, times of day and where the sheets go live in a YAML file;
# see config.example.yaml. If the file does not exist, no history is recorded
# and no sheets are written.
#CONFIG_FILE=/config/config.yaml
