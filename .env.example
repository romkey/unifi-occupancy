# ---------------------------------------------------------------------------
# UniFi Protect
# ---------------------------------------------------------------------------
# Hostname or IP of the UniFi OS console (UDM / UNVR / Cloud Key).
UNIFI_HOST=192.168.1.1
# Create under UniFi OS -> Settings -> Admins & Users -> your user -> API Keys.
UNIFI_API_KEY=changeme
#UNIFI_PORT=443
# UniFi ships a self-signed certificate; set true only if you installed a real one.
#UNIFI_VERIFY_SSL=false
# Seconds between full camera polls.
#UNIFI_POLL_INTERVAL=5
#UNIFI_REQUEST_TIMEOUT=10
# Subscribe to the live event websocket in addition to polling.
#UNIFI_USE_WEBSOCKET=true

# ---------------------------------------------------------------------------
# MQTT
# ---------------------------------------------------------------------------
MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_CLIENT_ID=unifi-occupancy
#MQTT_TOPIC_PREFIX=unifi-occupancy
#MQTT_TLS=false
#MQTT_KEEPALIVE=60
#MQTT_RETAIN=true
#MQTT_QOS=0

# ---------------------------------------------------------------------------
# Home Assistant autodiscovery
# ---------------------------------------------------------------------------
#HA_DISCOVERY_ENABLED=true
#HA_DISCOVERY_PREFIX=homeassistant
#HA_NODE_ID=unifi_occupancy

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How long a detection stays ON after the last event reporting it.
#DETECTION_HOLD_SECONDS=30
#LOG_LEVEL=INFO
